# Forkloom minimal Firecracker x86_64 guest kernel fragment (Linux >= 5.18, target 6.6 LTS)
#
# Merged onto Firecracker's upstream microvm x86_64 base config (or x86_64_defconfig)
# via `scripts/kconfig/merge_config.sh` + `make olddefconfig`.
#
# Every critical symbol AND its parent Kconfig dependencies are explicitly pinned
# so `make olddefconfig` never silently drops a required feature. Verified against
# Linux 6.6 LTS Kconfig rules and verified by `build-kernel.sh` using
# `required-kconfig.txt`.

# ---------------------------------------------------------------------------
# 1. Architecture, KVM Guest & Static Moduleless MicroVM Baseline
# ---------------------------------------------------------------------------
CONFIG_64BIT=y
CONFIG_SMP=y
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
# Moduleless static vmlinux (all required drivers built-in; zero module loading overhead)
# CONFIG_MODULES is not set
# Linux 6.6 x86_64 `drivers/acpi/Kconfig` requires CONFIG_PCI=y for CONFIG_ACPI=y
# (which in turn gates CONFIG_VMGENID=y). Keep PCI enabled in Kconfig while
# disabling VIRTIO_PCI so Firecracker devices stay strictly on virtio-mmio.
CONFIG_PCI=y
# CONFIG_VIRTIO_PCI is not set
CONFIG_PRINTK=y
CONFIG_EARLY_PRINTK=y
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# ---------------------------------------------------------------------------
# 2. Virtio MMIO Transport (Required by Firecracker MicroVM)
# ---------------------------------------------------------------------------
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y

# ---------------------------------------------------------------------------
# 3. Post-Fork Entropy & Clone Uniqueness (VMGenID + Virtio RNG)
#    Dependencies:
#      VMGENID          <- ACPI + VIRT_DRIVERS
#      HW_RANDOM_VIRTIO <- HW_RANDOM + VIRTIO
# ---------------------------------------------------------------------------
CONFIG_ACPI=y
CONFIG_VIRT_DRIVERS=y
CONFIG_VMGENID=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y

# ---------------------------------------------------------------------------
# 4. Block Storage & RootFS (Virtio-Blk + Ext4)
#    Dependencies:
#      VIRTIO_BLK <- BLOCK + VIRTIO (selects SG_POOL)
#      EXT4_FS    <- BLOCK (selects JBD2, CRC16, CRC32, FS_IOMAP, CRYPTO_CRC32C)
# ---------------------------------------------------------------------------
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_VIRTIO_BLK=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y

# ---------------------------------------------------------------------------
# 5. Virtual Filesystems & Inspector Initramfs (cpio.zst)
# ---------------------------------------------------------------------------
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_ZSTD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_INOTIFY_USER=y
CONFIG_FUTEX=y

# ---------------------------------------------------------------------------
# 6. Cgroups v2 & Freezer (aos.workload FreezeAndSync + Per-Exec cgroup.kill)
#    Note: Cgroup v2 `cgroup.freeze` & `cgroup.events` live in core CGROUPS (>= 5.2).
#    CONFIG_CGROUP_FREEZER enables legacy v1 freezer as well per spec.
# ---------------------------------------------------------------------------
CONFIG_CGROUPS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_MEMCG=y
CONFIG_CPUSETS=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# ---------------------------------------------------------------------------
# 7. Networking, Vsock & Post-Fork External TCP Socket Destroy
#    Dependencies:
#      VIRTIO_VSOCKETS   <- NET + VSOCKETS + VIRTIO (selects VIRTIO_VSOCKETS_COMMON)
#      INET_TCP_DIAG     <- NET + INET + INET_DIAG (MUST be =y in moduleless vmlinux
#                           or NETLINK_SOCK_DIAG / `ss -K` fails with ENOENT!)
#      INET_DIAG_DESTROY <- NET + INET + INET_DIAG
# ---------------------------------------------------------------------------
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_VIRTIO_NET=y
CONFIG_VSOCKETS=y
CONFIG_VSOCKETS_LOOPBACK=y
CONFIG_VIRTIO_VSOCKETS=y
CONFIG_INET_DIAG=y
CONFIG_INET_TCP_DIAG=y
CONFIG_INET_DIAG_DESTROY=y

# ---------------------------------------------------------------------------
# 8. Trim Unused Subsystems to Keep Boot Fast & Attack Surface Minimal
# ---------------------------------------------------------------------------
# CONFIG_SOUND is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_WLAN is not set
# CONFIG_WIRELESS is not set
# CONFIG_DRM is not set
# CONFIG_FB is not set
# CONFIG_INPUT_KEYBOARD is not set
# CONFIG_INPUT_MOUSE is not set
# CONFIG_HIBERNATION is not set
# CONFIG_SUSPEND is not set
